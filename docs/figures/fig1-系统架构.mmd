flowchart TB
  subgraph L0["① 使用端"]
    direction LR
    D1["Claude Code / Codex / Reasonix"]
    D2["DeepSeek Harness（含侧边栏面板）"]
  end

  subgraph L3["② 出口层"]
    direction LR
    C1["src/mcp/<br/>stdio MCP server"]
    C2["src/service/<br/>Streamable HTTP 服务"]
    C3["src/dsh/<br/>宿主插件 + 侧边栏"]
  end

  subgraph L4["③ 服务层（HTTP 三入口）src/service"]
    direction LR
    E1["POST /mcp<br/>Bearer 鉴权 http.ts<br/>无 token → 401"]
    E2["GET /healthz<br/>免鉴权，只报总数"]
    E3["GET /catalog<br/>免鉴权，市场运行时数据源"]
    E4["按请求选源 subset.ts<br/>x-plantomics-sources"]
    E5["预算口径 budget.ts<br/>订阅集 80 硬 / 默认集 40 软<br/>全库只统计不拦截"]
  end

  subgraph L1["④ 注册表层 src/core"]
    direction LR
    A1["契约 types<br/>纯 JSON Schema"]
    A2["HTTP 客户端<br/>超时 / UA / 确定性退避"]
    A3["注册表硬校验 registry.ts<br/>T3 不许挂工具"]
    A4["输出排版 format.ts<br/>UTF-8 字节预算 + 出处尾注"]
  end

  subgraph L2["⑤ 适配层 src/sources/:id"]
    direction LR
    B1["manifest.ts<br/>等级 / apiBase / 版本口径"]
    B2["tools.ts<br/>意图级工具，每源按能力定<br/>不设每源硬上限"]
    B3["fixtures/<br/>真实响应裁剪快照"]
  end

  subgraph L5["⑥ 检索层 src/retrieval"]
    direction LR
    R1["hub_find_sources<br/>按作物/用途筛源<br/>给出每源工具数与覆盖范围"]
    R2["hub_status<br/>服务与源状态自述"]
  end

  subgraph L6["⑦ 源市场（v2.3）"]
    direction LR
    M1["全库：源数与工具数只统计<br/>不拦截"]
    M2["默认推荐集 ≤ 40 工具<br/>超了只警示"]
    M3["单次订阅集 ≤ 80 工具<br/>超了服务端 400"]
  end

  L0 --> L3
  C2 --> L4
  C1 --> L1
  C3 --> L1
  L4 --> L1
  L5 --> L1
  L1 --> L2
  M1 -.-> L4
  M2 -.-> E5
  M3 -.-> E5
  E3 -.-> M2
  R1 -.-> M3

  classDef meta fill:#eef6ff,stroke:#3b82f6,stroke-width:1px
  class M1,M2,M3 meta
