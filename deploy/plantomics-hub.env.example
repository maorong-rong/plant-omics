# PlantOmics Hub —— 环境变量模板（部署物料）
#
# 复制到 /etc/plantomics-hub.env，改完执行：
#   sudo chown root:root /etc/plantomics-hub.env && sudo chmod 600 /etc/plantomics-hub.env
#
# 注意：
#   - 不配 TOKEN 时**只能绑回环**（服务端会拒绝非回环监听）；
#   - TOKEN 至少 16 字符，短 token 等于没有鉴权；
#   - 对外域名必须写进 ALLOWED_HOSTS，否则 Host 校验会 403。

# 监听地址：经 Nginx 反代时保持 127.0.0.1；容器/裸机直连才写 0.0.0.0（此时必须配 TOKEN）
PLANTOMICS_HUB_HOST=127.0.0.1
PLANTOMICS_HUB_PORT=8787

# 静态 Bearer token（客户端以 Authorization: Bearer <token> 携带）
# 生成： openssl rand -hex 32
PLANTOMICS_HUB_TOKEN=CHANGE_ME_AT_LEAST_16_CHARS

# 服务端自报名字（字母/数字/下划线/连字符，1–32）
PLANTOMICS_HUB_SERVER_NAME=plantomics-hub

# info | quiet
PLANTOMICS_HUB_LOG=info

# 允许的 Host 头（逗号分隔，只写主机名，不带协议和路径）
PLANTOMICS_HUB_ALLOWED_HOSTS=example.org,www.example.org

# 可选：只启用部分源（逗号/分号/空白分隔）；不填 = 全部
#PLANTOMICS_SOURCES=wheatomics,icg,scod
